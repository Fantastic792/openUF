#!/bin/sh /etc/rc.common
# openUF: the 802.11r key-exchange translator for genuine UniFi APs
# (rrb/rrb-unifi.uc, vendored from d-malinowski/unifi-openwrt-roaming; see
# rrb/README.md). hostapd's inter-AP RRB frames leave through a veth pair
# (vft0, hostapd's ft_iface; vft1, this daemon's end) and are reframed the way
# UniFi's hostapd frames them, and back. openUF writes the hostapd options and
# creates the veth on a config push (ftinterop.lua, ucihelper.ensure_ft_veth);
# until then the daemon waits. Its settings are the `rrb` section of
# /etc/config/openuf, every one optional:
#
#   config rrb 'rrb'
#       option enabled '1'         0 keeps the daemon off; openUF then never
#                                  points hostapd at the veth
#       option ft_iface 'vft0'     hostapd's end of the veth
#       option peer_iface 'vft1'   the daemon's end
#       option lan_iface ''        the LAN bridge the UniFi APs are on; empty
#                                  derives it from the running hostapd configs
#       option roam_announce '1'   UniFi's roam announcements (UBNT_ROAM)
#       option verbose '0'         1 logs every translated frame
#       list peer 'bssid,r0kh-id'  a UniFi BSS listed by hand (ftinterop.lua
#                                  learns them from the LAN otherwise)

START=99
STOP=01
USE_PROCD=1

extra_command "check" "Show what the translator derives from the running hostapd configs"

# The package installs under /usr/lib/openuf, install.sh under /opt/openuf;
# whichever holds inform.lua is the tree that runs (same rule as openuf).
OPENUF_DIR=""
for d in /usr/lib/openuf /opt/openuf; do
	if [ -f "$d/inform.lua" ] && [ -f "$d/rrb/rrb-unifi.uc" ]; then OPENUF_DIR=$d; break; fi
done
RUN_DIR=/var/run/openuf
PEERS_FILE=$RUN_DIR/rrb-peers.json

load_settings() {
	config_load openuf
	config_get_bool ENABLED rrb enabled 1
	config_get_bool VERBOSE rrb verbose 0
	config_get FT_IF rrb ft_iface vft0
	config_get PEER_IF rrb peer_iface vft1
	config_get LAN_IF rrb lan_iface ''
	config_get_bool ROAM rrb roam_announce 1
}

start_service() {
	if [ -z "$OPENUF_DIR" ]; then
		echo "openuf-rrb: not installed (no rrb/rrb-unifi.uc under /usr/lib/openuf or /opt/openuf)" >&2
		return 1
	fi
	if ! command -v ucode >/dev/null 2>&1; then
		echo "openuf-rrb: ucode is not installed; the translator runs on it" >&2
		return 1
	fi
	load_settings
	if [ "$ENABLED" != 1 ]; then
		echo "openuf-rrb: disabled (openuf.rrb.enabled=0)"
		return 0
	fi
	mkdir -p "$RUN_DIR"
	procd_open_instance
	procd_set_param command /usr/bin/ucode "$OPENUF_DIR/rrb/rrb-unifi.uc"
	# RRB_WAIT=0: wait for the veth and for a BSS on it rather than exit, so
	# procd never has to respawn a daemon that found nothing to do yet.
	procd_set_param env RRB_FT_IF="$FT_IF" RRB_PEER_IF="$PEER_IF" RRB_LAN_IF="$LAN_IF" \
		RRB_WAIT=0 RRB_VERBOSE="$VERBOSE" RRB_ROAM="$ROAM" RRB_PEERS_FILE="$PEERS_FILE"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# A LuCI apply of the openuf, wireless or network config restarts the daemon:
# it reads the hostapd configs and derives the LAN bridge at start. openUF's
# own pushes do not raise this event (libuci-lua emits none); apply_config
# restarts the service itself after a push that put a BSS on the veth.
service_triggers() {
	procd_add_reload_trigger "openuf" "wireless" "network"
}

reload_service() {
	stop
	start
}

check() {
	[ -n "$OPENUF_DIR" ] || { echo "openuf-rrb: not installed" >&2; return 1; }
	load_settings
	RRB_CHECK=1 RRB_FT_IF="$FT_IF" RRB_PEER_IF="$PEER_IF" RRB_LAN_IF="$LAN_IF" RRB_ROAM="$ROAM" \
		RRB_PEERS_FILE="$PEERS_FILE" /usr/bin/ucode "$OPENUF_DIR/rrb/rrb-unifi.uc"
}
