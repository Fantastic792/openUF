{#
 Halo theme for LuCI.
 Copyright 2026 Yesrab Ali <yesrab.ali111@gmail.com>
 Licensed to the public under the Apache License 2.0.

 The shell: a rail of section icons, the section's page list beside it, a
 top bar with the breadcrumb and LuCI's indicators, and the page. menu-halo.js
 fills the rail, the list, the crumbs and the page tabs from LuCI's menu.
 Structure follows luci-theme-bootstrap's header (Copyright 2008 Steven
 Barth, 2012 David Menting, 2008-2022 Jo-Philipp Wich), Apache License 2.0.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	// halo-dark / halo-light pin the scheme; plain halo follows the browser
	// and the appearance toggle in the rail.
	const darkpref = (theme == 'halo-dark' ? 'true' : (theme == 'halo-light' ? 'false' : null));
	const hostname = boardinfo.hostname ?? '?';
	const model = boardinfo.model ?? '';

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}"{{ darkpref ? ` data-darkmode="${darkpref}" data-pinned=""` : '' }}>
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${dispatched?.title ? `${_(dispatched.title)} · ` : ''}${hostname}`) }}</title>
		<script>
			(function() {
				var root = document.documentElement, pref = 'auto', nav = '';
				try { pref = localStorage.getItem('halo.theme') || 'auto'; nav = localStorage.getItem('halo.nav') || ''; } catch (e) {}
				{% if (!darkpref): %}
				if (pref !== 'light' && pref !== 'dark') pref = 'auto';
				var dark = pref === 'dark' || (pref === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				root.setAttribute('data-darkmode', dark ? 'true' : 'false');
				root.setAttribute('data-theme', pref);
				{% endif %}
				/* the navigation's shape before first paint: a bar on phones, a rail
				   on narrow screens or by choice, the full sidebar otherwise */
				root.setAttribute('data-nav', window.matchMedia('(max-width: 720px)').matches ? 'bar'
					: (nav === 'rail' || window.matchMedia('(max-width: 1100px)').matches) ? 'rail' : 'side');
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="color-scheme" content="light dark">
		<meta name="darkreader-lock">
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml" sizes="any">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }}{{ blank_page ? ' halo-blank' : '' }}{{ halo_login ? ' halo-login-page' : '' }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
		{% if (!blank_page): %}
		<div class="halo-shell">
			<nav class="halo-side" id="halo-side" aria-label="{{ _('Navigation') }}">
				<a class="halo-brand" href="/" title="{{ entityencode(model ? `${hostname} · ${model}` : hostname, true) }}">
					<span class="halo-mark" aria-hidden="true"></span>
					<span class="halo-brand-text"><b>{{ striptags(hostname) }}</b>{% if (model): %}<small>{{ striptags(model) }}</small>{% endif %}</span>
				</a>
				<ul class="halo-nav" id="halo-nav"></ul>
				<ul class="halo-modemenu" id="modemenu" hidden></ul>
				<div class="halo-side-foot">
					{% if (!darkpref): %}
					<button type="button" class="halo-nav-link halo-theme" id="halo-theme" data-label="{{ _('Appearance') }}" aria-label="{{ _('Appearance') }}">
						<span class="halo-icon" aria-hidden="true"></span>
						<span class="halo-nav-label">{{ _('Appearance') }}</span>
					</button>
					{% endif %}
					<button type="button" class="halo-nav-link halo-collapse" id="halo-collapse" aria-pressed="false" data-label="{{ _('Collapse navigation') }}" aria-label="{{ _('Collapse navigation') }}">
						<span class="halo-icon" aria-hidden="true"></span>
						<span class="halo-nav-label">{{ _('Collapse') }}</span>
					</button>
					<span class="halo-nav-logout" id="halo-nav-logout"></span>
				</div>
			</nav>

			<aside class="halo-subnav" id="halo-subnav" aria-label="{{ _('Pages') }}" hidden>
				<div class="halo-subnav-head" id="halo-subnav-head"></div>
				<ul class="halo-subnav-list" id="halo-subnav-list"></ul>
			</aside>
			<div class="halo-scrim" id="halo-scrim" hidden></div>

			<div class="halo-main">
				<header class="halo-topbar">
					<nav class="halo-crumbs" id="halo-crumbs" aria-label="{{ _('Location') }}"></nav>
					<div class="halo-top-end">
						<div id="indicators"></div>
						<span class="halo-host" title="{{ entityencode(model ? `${hostname} · ${model}` : hostname, true) }}">
							<b>{{ striptags(hostname) }}</b>{% if (model): %}<span class="halo-host-model">{{ striptags(model) }}</span>{% endif %}
						</span>
					</div>
				</header>

				<div id="maincontent" class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
						<div class="alert-message warning">
							<h4>{{ _('No password set!') }}</h4>
							<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
							{% if (dispatcher.lookup("admin/system/admin")): %}
							<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					{% if (boardinfo.rootfs_type == "initramfs"): %}
						<div class="alert-message warning">
							<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
							<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
							{% if (dispatcher.lookup("admin/system/flash")): %}
							<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" hidden></div>
		{% endif %}
